# Token bot Telegram (tạo bằng @BotFather). BẮT BUỘC.
TELEGRAM_TOKEN=

# ID Telegram được phép ra lệnh, cách nhau dấu phẩy. BẮT BUỘC (rỗng = không chạy).
# Chưa biết ID: nhắn /id cho bot, bot trả lại ID của bạn (chỉ lệnh /id trả lời người lạ).
ALLOWED_USER_IDS=

# Quản trị viên (tập con của ALLOWED_USER_IDS): dùng được bộ công cụ adminOnly (như /lam) và duyệt lệnh/ghi file.
# Không đặt = mọi người được phép đều là admin. Đặt rỗng = không ai là admin.
ADMIN_USER_IDS=

# Chờ người dùng bấm Cho phép/Từ chối bao lâu (giây) rồi tự TỪ CHỐI
APPROVAL_TIMEOUT_SEC=300

# --- Độ bền (GĐ 5) ---
# Cô lập tiến trình AI bằng bubblewrap (chỉ Linux): off | auto (dùng nếu chạy được, không thì báo) | bwrap (bắt buộc)
SANDBOX=off
# Đường dẫn bị che khỏi tiến trình AI (cách nhau dấu phẩy), ngoài thư mục dữ liệu của bộ điều phối và .env
SANDBOX_HIDE=/etc/agentos
# Không nhận việc khi ổ đĩa còn dưới số MB này
MIN_FREE_MB=300
# Nhắn quản trị viên mỗi lần khởi động (phát hiện máy vừa mất điện/khởi động lại)
BOOT_NOTICE=true
# Lỗi tạm thời (AI quá tải, rớt mạng): thử lại sau từng khoảng này (giây)
TRANSIENT_RETRY_SEC=15,60,180
# Giữ việc/nhật ký/file kết quả bao nhiêu ngày; giữ bao nhiêu bản sao lưu cơ sở dữ liệu (mỗi ngày một bản)
JOB_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=180
OUT_RETENTION_DAYS=14
BACKUP_KEEP=7

# Thứ tự ưu tiên engine. Engine đầu hết hạn mức thì chuyển sang engine kế.
# Chỉ liệt kê engine đã cài VÀ đã đăng nhập (claude login / codex login) bằng tài khoản của chính bạn.
ENGINE_ORDER=claude
# ENGINE_ORDER=claude,codex

# Đường dẫn lệnh (mặc định: trong PATH)
CLAUDE_BIN=claude
CODEX_BIN=codex

# Codex: mức sandbox (read-only | workspace-write | danger-full-access). Mặc định chỉ đọc.
CODEX_SANDBOX=read-only

# Không đọc được giờ hồi hạn mức từ thông báo của CLI thì engine nghỉ bấy nhiêu phút
LIMIT_COOLDOWN_MIN=60

# Thư mục làm việc của AI. Nên là thư mục riêng, không phải thư mục chứa dữ liệu quan trọng.
WORKDIR=./work

# Công cụ AI được tự dùng, không cần hỏi. Mặc định CHỈ ĐỌC. Thêm Edit,Write,Bash... là tự chịu rủi ro.
CLAUDE_ALLOWED_TOOLS=Read,Glob,Grep

# Bộ công cụ (MCP: trình duyệt...) chọn bằng lệnh /<tên>, ví dụ /web <việc>.
# Chép tools.example.json (Windows/dev) hoặc tools.linux.json (máy AgentOS) thành tools.json rồi trỏ vào đây.
# Để trống = chỉ dùng CLAUDE_ALLOWED_TOOLS ở trên (không có /web).
TOOLS_FILE=
# Trình duyệt dùng cho Playwright (tùy cấu hình tools.json)
CHROME_PATH=

# Giới hạn thời gian mỗi việc (giây)
JOB_TIMEOUT_SEC=900

# File cơ sở dữ liệu
DB_PATH=./data/agentos.db
