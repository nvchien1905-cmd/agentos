# Sao chép thành /etc/agentos/orchestrator.env (quyền 600, chủ sở hữu agentos) rồi điền.
# Trình hướng dẫn lần đầu (GĐ 6b) sẽ tạo file này.
TELEGRAM_TOKEN=
ALLOWED_USER_IDS=
ADMIN_USER_IDS=
APPROVAL_TIMEOUT_SEC=300
ENGINE_ORDER=claude,codex
WORKDIR=/var/lib/agentos/work
DB_PATH=/var/lib/agentos/data/agentos.db
TOOLS_FILE=/opt/agentos/orchestrator/tools.json
CLAUDE_ALLOWED_TOOLS=Read,Glob,Grep
CODEX_SANDBOX=read-only
# Cô lập tiến trình AI bằng bubblewrap: off | auto (dùng nếu chạy được, không thì báo) | bwrap (bắt buộc)
SANDBOX=auto
# Không nhận việc khi ổ đĩa còn dưới số MB này
MIN_FREE_MB=500
