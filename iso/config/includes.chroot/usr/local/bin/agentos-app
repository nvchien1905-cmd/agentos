#!/bin/sh
# Mở ứng dụng web thành cửa sổ riêng (như ứng dụng cài sẵn) bằng Google Chrome: zalo | deepseek | ...
# Địa chỉ sửa được ở /etc/agentos/apps.conf.
[ -f /etc/agentos/apps.conf ] && . /etc/agentos/apps.conf
case "$1" in
  zalo) URL="${ZALO_URL:-https://chat.zalo.me}"; NAME=zalo ;;
  deepseek) URL="${DEEPSEEK_URL:-https://chat.deepseek.com}"; NAME=deepseek ;;
  claudeweb) URL="${CLAUDE_URL:-https://claude.ai}"; NAME=claudeweb ;;
  chatgpt) URL="${CHATGPT_URL:-https://chatgpt.com}"; NAME=chatgpt ;;
  office365) URL="${OFFICE_URL:-https://www.office.com}"; NAME=office365 ;;
  *) echo "Dùng: agentos-app zalo|deepseek|claudeweb|chatgpt|office365"; exit 1 ;;
esac
BROWSER=/usr/bin/google-chrome-stable; [ -x "$BROWSER" ] || BROWSER=/usr/bin/chromium
# Mỗi ứng dụng một hồ sơ riêng: đăng nhập giữ lại, không lẫn với trình duyệt thường
# --disable-gpu: Chrome 157 trên máy thật (Intel HD 630) vẽ TRẮNG trang Zalo sau khi đăng nhập; tắt tăng tốc đồ họa thì hiện bình thường (đã thử 05/11/2026)
exec "$BROWSER" --app="$URL" --user-data-dir="$HOME/.config/agentos-app-$NAME" --password-store=basic --no-first-run --no-default-browser-check --disable-gpu --lang=vi "$@"
