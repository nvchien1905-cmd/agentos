#!/bin/sh
# Bộ công cụ cho AI làm việc không cần chủ máy động tay: nhận dạng giọng nói (tin nhắn thoại Telegram), Tailscale (đường vào dự phòng),
# in ấn (CUPS), sao lưu hằng ngày lên OneDrive. Gói văn phòng/PDF/OCR nằm trong package-lists/agentos.list.chroot.
set -e
id agentos >/dev/null 2>&1

chmod 0755 /usr/local/bin/agentos-stt /usr/local/bin/agentos-sao-luu /usr/local/bin/agentos-key /usr/local/bin/agentos-update

# --- Nhận dạng giọng nói: faster-whisper trong môi trường riêng. Ghim phiên bản (av mới nhất không khớp). Mô hình tải ở lần dùng đầu (~500MB).
python3 -m venv /opt/agentos/stt-venv
/opt/agentos/stt-venv/bin/pip install --no-cache-dir "faster-whisper==1.2.1" "av==16.1.0"
/opt/agentos/stt-venv/bin/python -c "import faster_whisper, av; print('faster-whisper', faster_whisper.__version__, 'av', av.__version__)"
mkdir -p /var/lib/agentos/whisper
chown -R agentos:agentos /var/lib/agentos/whisper

# --- Tailscale (kho chính thức của Tailscale cho Debian trixie)
curl -fsSL https://pkgs.tailscale.com/stable/debian/trixie.noarmor.gpg -o /usr/share/keyrings/tailscale-archive-keyring.gpg
curl -fsSL https://pkgs.tailscale.com/stable/debian/trixie.tailscale-keyring.list -o /etc/apt/sources.list.d/tailscale.list
apt-get update
apt-get install -y --no-install-recommends tailscale
test -x /usr/bin/tailscale
systemctl enable tailscaled || true

# --- In ấn: CUPS chỉ nghe ở máy này (localhost:631); người dùng máy vào nhóm lpadmin để thêm máy in
systemctl enable cups || true
if [ -f /etc/calamares/modules/users.conf ] && ! grep -q '^    - lpadmin$' /etc/calamares/modules/users.conf; then
	sed -i '0,/^defaultGroups:/s//defaultGroups:\n    - lpadmin/' /etc/calamares/modules/users.conf
fi

# --- Sao lưu hằng ngày
systemctl enable agentos-sao-luu.timer || true

# --- Cập nhật phần mềm không cần boot lại (bản cập nhật phải có chữ ký khớp /etc/agentos/update-pubkey.pem)
systemctl enable agentos-update.path || true
test -s /etc/agentos/update-pubkey.pem || { echo "[LOI] thieu khoa cong khai cap nhat"; exit 1; }

# Kiểm tra các lệnh AI sẽ dùng
for c in soffice pdftotext tesseract convert ffmpeg jq sqlite3 lp; do
	command -v "$c" >/dev/null 2>&1 || { echo "[LOI] thieu lenh $c"; exit 1; }
done
tesseract --list-langs 2>&1 | grep -qx vie || { echo "[LOI] tesseract thieu ngon ngu vie"; exit 1; }
python3 -c "import pandas, openpyxl, docx, xlsxwriter, odf, reportlab" || { echo "[LOI] thieu thu vien Python van phong"; exit 1; }
exit 0
