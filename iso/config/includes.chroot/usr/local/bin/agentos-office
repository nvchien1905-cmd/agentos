#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""agentos-office: đọc / sửa / đổi định dạng tệp Word, Excel, PowerPoint (và LibreOffice, PDF, văn bản) KHÔNG cần mở giao diện.
Dùng cho bot Telegram (/doc, /doi) và cho AI.

  agentos-office read <tệp> [--max 6000]        in nội dung chữ: .docx/.doc/.odt/.rtf (đoạn + bảng), .xlsx/.xls/.ods (từng trang tính),
                                                .pptx/.ppt/.odp (từng slide + ghi chú), .pdf, .txt/.md/.csv. Định dạng cũ được LibreOffice đổi tạm sang định dạng mới
  agentos-office replace <tệp> <cũ> <mới> [--out <tệp ra>]
                                                thay chữ trong .docx/.pptx/.xlsx giữ nguyên bố cục (mặc định lưu bản sao *-moi.*, KHÔNG ghi đè tệp gốc)
  agentos-office convert <tệp> <định dạng> [--outdir <thư mục>]
                                                đổi định dạng bằng LibreOffice: pdf, docx, xlsx, pptx, odt, ods, odp, csv, txt, html
  agentos-office create <docx|xlsx|pptx|pdf> <mô-tả.json> --out <tệp ra>
                                                tạo tệp MỚI từ mô tả có cấu trúc (xem orchestrator/src/docgen.js)
  agentos-office info <tệp>                     loại tệp, kích thước, số trang tính/slide
Tạo mới: dùng python-docx / openpyxl (có sẵn) hoặc python-pptx trong /opt/agentos/office-venv/bin/python (nếu cài được), rồi `convert` nếu cần PDF.
"""
import os
import re
import sys
import shutil
import subprocess
import tempfile
import zipfile
import xml.etree.ElementTree as ET

W = '{http://schemas.openxmlformats.org/wordprocessingml/2006/main}'
A = '{http://schemas.openxmlformats.org/drawingml/2006/main}'
NEW = {'.doc': 'docx', '.odt': 'docx', '.rtf': 'docx', '.xls': 'xlsx', '.ods': 'xlsx', '.ppt': 'pptx', '.odp': 'pptx', '.pps': 'pptx'}


def die(msg, code=1):
    sys.stderr.write('LỖI: %s\n' % msg)
    sys.exit(code)


def soffice_convert(src, fmt, outdir):
    exe = shutil.which('soffice') or shutil.which('libreoffice')
    if not exe:
        die('Máy chưa có LibreOffice (soffice).')
    prof = tempfile.mkdtemp(prefix='lo-prof-')
    try:
        r = subprocess.run([exe, '--headless', '--norestore', '-env:UserInstallation=file://' + prof, '--convert-to', fmt, '--outdir', outdir, src],
                           capture_output=True, text=True, timeout=180)
    except subprocess.TimeoutExpired:
        die('LibreOffice chạy quá 180 giây.')
    finally:
        shutil.rmtree(prof, ignore_errors=True)
    out = os.path.join(outdir, os.path.splitext(os.path.basename(src))[0] + '.' + fmt.split(':')[0])
    if r.returncode != 0 or not os.path.exists(out):
        die('Đổi định dạng thất bại: ' + (r.stderr or r.stdout).strip()[:300])
    return out


def text_of(el, tag):
    return ''.join(t.text or '' for t in el.iter(tag))


def read_docx(path):
    with zipfile.ZipFile(path) as z:
        root = ET.fromstring(z.read('word/document.xml'))
    body = root.find(W + 'body')
    out = []
    for ch in list(body):
        if ch.tag == W + 'p':
            t = text_of(ch, W + 't').strip()
            style = ch.find('.//' + W + 'pStyle')
            if t:
                head = style is not None and (style.get(W + 'val') or '').lower().startswith(('heading', 'title'))
                out.append(('# ' if head else '') + t)
        elif ch.tag == W + 'tbl':
            for tr in ch.iter(W + 'tr'):
                out.append(' | '.join(text_of(tc, W + 't').strip() for tc in tr.findall(W + 'tc')))
            out.append('')
    return '\n'.join(out)


def read_pptx(path):
    with zipfile.ZipFile(path) as z:
        names = z.namelist()
        slides = sorted((n for n in names if re.match(r'ppt/slides/slide\d+\.xml$', n)), key=lambda n: int(re.findall(r'\d+', n)[-1]))
        out = []
        for i, n in enumerate(slides, 1):
            root = ET.fromstring(z.read(n))
            paras = []
            for p in root.iter(A + 'p'):
                t = text_of(p, A + 't').strip()
                if t:
                    paras.append(t)
            out.append('--- Slide %d ---\n%s' % (i, '\n'.join(paras)))
            note = 'ppt/notesSlides/notesSlide%s.xml' % re.findall(r'\d+', n)[-1]
            if note in names:
                nt = [text_of(p, A + 't').strip() for p in ET.fromstring(z.read(note)).iter(A + 'p')]
                nt = [t for t in nt if t and not t.isdigit()]
                if nt:
                    out.append('(ghi chú) ' + ' '.join(nt))
    return '\n'.join(out)


def read_xlsx(path, rows=60):
    try:
        import openpyxl
    except ImportError:
        die('Thiếu thư viện openpyxl.')
    wb = openpyxl.load_workbook(path, data_only=True, read_only=True)
    out = []
    for ws in wb.worksheets:
        out.append('--- Trang tính "%s" (%s dòng × %s cột) ---' % (ws.title, ws.max_row, ws.max_column))
        n = 0
        for row in ws.iter_rows(values_only=True):
            if all(c is None for c in row):
                continue
            out.append(' | '.join('' if c is None else str(c) for c in row))
            n += 1
            if n >= rows:
                out.append('… (còn nữa, chỉ in %d dòng đầu; cần đủ thì dùng openpyxl/pandas)' % rows)
                break
    return '\n'.join(out)


def read_any(path):
    ext = os.path.splitext(path)[1].lower()
    if ext in NEW:
        tmp = tempfile.mkdtemp(prefix='ao-')
        try:
            return read_any(soffice_convert(path, NEW[ext], tmp))
        finally:
            shutil.rmtree(tmp, ignore_errors=True)
    if ext == '.docx':
        return read_docx(path)
    if ext == '.pptx':
        return read_pptx(path)
    if ext in ('.xlsx', '.xlsm'):
        return read_xlsx(path)
    if ext == '.pdf':
        exe = shutil.which('pdftotext')
        if not exe:
            die('Máy chưa có pdftotext.')
        r = subprocess.run([exe, '-layout', path, '-'], capture_output=True, text=True, timeout=120)
        if r.returncode != 0:
            die('pdftotext lỗi: ' + r.stderr[:200])
        return r.stdout
    if ext in ('.txt', '.md', '.csv', '.json', '.log', '.xml', '.html', '.htm', '.tsv', '.ini', '.conf'):
        with open(path, 'r', encoding='utf-8', errors='replace') as f:
            return f.read()
    die('Chưa đọc được loại tệp "%s". Thử: agentos-office convert <tệp> pdf' % ext)


def replace_in_xml(data, old, new, kind):
    """Thay chữ bằng cách sửa THẲNG trên văn bản XML (không dựng lại cây XML nên giữ nguyên mọi khai báo, kiểu chữ, bố cục).
    Chữ bị Word/PowerPoint chẻ làm nhiều khối <t> trong cùng một đoạn vẫn thay được: chữ mới nằm ở khối đầu (định dạng của khối đầu),
    các khối sau của đoạn đó bị rỗng."""
    from xml.sax.saxutils import escape, unescape
    text = data.decode('utf-8')
    para, tt = kind
    para_re = re.compile(r'<%s(?:\s[^>]*)?>.*?</%s>' % (para, para), re.S)
    t_re = re.compile(r'(<%s(?:\s[^>]*)?>)(.*?)(</%s>)' % (tt, tt), re.S)
    count = [0]

    def fix_para(m):
        block = m.group(0)
        parts = t_re.findall(block)
        if not parts:
            return block
        full = ''.join(unescape(x[1]) for x in parts)
        if old not in full:
            return block
        count[0] += full.count(old)
        result = escape(full.replace(old, new))
        first = [True]

        def put(mt):
            if first[0]:
                first[0] = False
                open_tag = mt.group(1)
                if 'xml:space' not in open_tag:
                    open_tag = open_tag[:-1] + ' xml:space="preserve">'
                return open_tag + result + mt.group(3)
            return mt.group(1) + mt.group(3)
        return t_re.sub(put, block)

    return para_re.sub(fix_para, text).encode('utf-8'), count[0]


def do_replace(path, old, new, out):
    ext = os.path.splitext(path)[1].lower()
    rules = {
        '.docx': [(re.compile(r'^word/(document|header\d*|footer\d*|footnotes|endnotes)\.xml$'), ('w:p', 'w:t'))],
        '.pptx': [(re.compile(r'^ppt/(slides/slide|notesSlides/notesSlide)\d+\.xml$'), ('a:p', 'a:t'))],
        '.xlsx': [(re.compile(r'^xl/sharedStrings\.xml$'), ('si', 't')), (re.compile(r'^xl/worksheets/sheet\d+\.xml$'), ('is', 't'))],   # chữ dùng chung + chữ nằm thẳng trong ô
    }.get(ext)
    if not rules:
        die('Chỉ thay chữ trực tiếp được trong .docx .pptx .xlsx (tệp khác: đổi sang định dạng mới bằng convert trước).')
    if not out:
        base, e = os.path.splitext(path)
        out = base + '-moi' + e
    total = 0
    with zipfile.ZipFile(path) as zin, zipfile.ZipFile(out, 'w', zipfile.ZIP_DEFLATED) as zout:
        for item in zin.infolist():
            data = zin.read(item.filename)
            for rx, kind in rules:
                if rx.match(item.filename):
                    data, n = replace_in_xml(data, old, new, kind)
                    total += n
            zout.writestr(item, data)
    return out, total


# ---------- TẠO TÀI LIỆU MỚI từ mô tả JSON (orchestrator/src/docgen.js dựng mô tả) ----------
INLINE_RE = re.compile(r'(\*\*[^*]+\*\*|\*[^*\n]+\*|`[^`]+`|\[[^\]]+\]\(https?://[^\s)]+\))')
IMG_EXT = ('.png', '.jpg', '.jpeg', '.gif', '.bmp')


def _hyperlink(par, url, text):
    from docx.opc.constants import RELATIONSHIP_TYPE as RT
    from docx.oxml import OxmlElement
    from docx.oxml.ns import qn
    rid = par.part.relate_to(url, RT.HYPERLINK, is_external=True)
    h = OxmlElement('w:hyperlink')
    h.set(qn('r:id'), rid)
    r = OxmlElement('w:r')
    rpr = OxmlElement('w:rPr')
    u = OxmlElement('w:u')
    u.set(qn('w:val'), 'single')
    c = OxmlElement('w:color')
    c.set(qn('w:val'), '1D4ED8')
    rpr.append(u)
    rpr.append(c)
    r.append(rpr)
    t = OxmlElement('w:t')
    t.text = text
    r.append(t)
    h.append(r)
    par._p.append(h)


def _runs(par, text):
    for t in INLINE_RE.split(text or ''):
        if not t:
            continue
        if t.startswith('**') and t.endswith('**') and len(t) > 4:
            par.add_run(t[2:-2]).bold = True
        elif t.startswith('`') and t.endswith('`') and len(t) > 2:
            run = par.add_run(t[1:-1])
            run.font.name = 'DejaVu Sans Mono'
        elif t.startswith('*') and t.endswith('*') and len(t) > 2:
            par.add_run(t[1:-1]).italic = True
        elif t.startswith('['):
            m = re.match(r'\[([^\]]+)\]\((https?://[^\s)]+)\)', t)
            if m:
                _hyperlink(par, m.group(2), m.group(1))
            else:
                par.add_run(t)
        else:
            par.add_run(t)


def _shade(cell, color):
    from docx.oxml import OxmlElement
    from docx.oxml.ns import qn
    tcpr = cell._tc.get_or_add_tcPr()
    shd = OxmlElement('w:shd')
    shd.set(qn('w:val'), 'clear')
    shd.set(qn('w:color'), 'auto')
    shd.set(qn('w:fill'), color)
    tcpr.append(shd)


def create_docx(spec, out):
    try:
        import docx
        from docx.shared import Pt, Inches, Mm, RGBColor
    except ImportError:
        die('Máy chưa có python-docx (gói python3-docx).')
    d = docx.Document()
    theme = spec.get('theme') or 'bao-cao'
    st = d.styles['Normal']
    st.font.name = 'Caladea' if theme == 'thu' else 'Carlito'
    st.font.size = Pt(12 if theme == 'thu' else 11)
    for s in d.sections:
        s.page_width = Mm(210)
        s.page_height = Mm(297)
        s.left_margin = s.right_margin = Mm(22)
        s.top_margin = s.bottom_margin = Mm(20)
    d.add_heading(spec.get('title') or 'Tài liệu', 0)
    meta = ' · '.join([x for x in (spec.get('subtitle'), spec.get('author'), spec.get('date')) if x])
    if meta:
        p = d.add_paragraph()
        r = p.add_run(meta)
        r.italic = True
        r.font.color.rgb = RGBColor(0x64, 0x74, 0x8B)
    for b in spec.get('blocks') or []:
        t = b.get('t')
        if t in ('h1', 'h2', 'h3'):
            d.add_heading(b.get('text') or '', int(t[1]))
        elif t == 'p':
            for chunk in (b.get('text') or '').split('\n'):
                _runs(d.add_paragraph(), chunk)
        elif t == 'quote':
            p = d.add_paragraph(style='Intense Quote')
            _runs(p, b.get('text') or '')
        elif t == 'code':
            p = d.add_paragraph()
            run = p.add_run(b.get('text') or '')
            run.font.name = 'DejaVu Sans Mono'
            run.font.size = Pt(9.5)
        elif t in ('ul', 'ol'):
            for it in b.get('items') or []:
                _runs(d.add_paragraph(style='List Bullet' if t == 'ul' else 'List Number'), it)
        elif t == 'table':
            rows = b.get('rows') or []
            tb = d.add_table(rows=len(rows), cols=len(rows[0]))
            tb.style = 'Table Grid'
            for i, row in enumerate(rows):
                for j, val in enumerate(row):
                    cell = tb.cell(i, j)
                    cell.text = ''
                    _runs(cell.paragraphs[0], str(val))
                    if i == 0 and b.get('header', True):
                        _shade(cell, '2563EB')
                        for r in cell.paragraphs[0].runs:
                            r.bold = True
                            r.font.color.rgb = RGBColor(0xFF, 0xFF, 0xFF)
            d.add_paragraph()
        elif t == 'img':
            pth = b.get('path') or ''
            if os.path.isfile(pth) and pth.lower().endswith(IMG_EXT):
                d.add_picture(pth, width=Inches(6))
                if b.get('caption'):
                    c = d.add_paragraph(b['caption'])
                    c.runs[0].italic = True
        elif t == 'pagebreak':
            d.add_page_break()
    d.save(out)


def create_xlsx(spec, out):
    try:
        import openpyxl
        from openpyxl.styles import Font, PatternFill, Alignment
        from openpyxl.utils import get_column_letter
    except ImportError:
        die('Máy chưa có openpyxl (gói python3-openpyxl).')
    wb = openpyxl.Workbook()
    wb.remove(wb.active)
    for sh in spec.get('sheets') or []:
        ws = wb.create_sheet((sh.get('name') or 'Trang')[:31])
        rows = sh.get('rows') or []
        for row in rows:
            ws.append(row)
        widths = {}
        for r in ws.iter_rows():
            for c in r:
                if c.value is not None:
                    widths[c.column] = max(widths.get(c.column, 0), min(60, len(str(c.value))))
                    c.alignment = Alignment(vertical='top', wrap_text=True)
        for col, w in widths.items():
            ws.column_dimensions[get_column_letter(col)].width = max(8, w + 2)
        if rows and sh.get('header', True):
            for c in ws[1]:
                c.font = Font(bold=True, color='FFFFFF')
                c.fill = PatternFill('solid', fgColor='2563EB')
            ws.freeze_panes = 'A2'
            if ws.max_column and ws.max_row > 1:
                ws.auto_filter.ref = ws.dimensions
    if not wb.sheetnames:
        wb.create_sheet('Trang 1')
    wb.save(out)


def create_pptx(spec, out):
    try:
        from pptx import Presentation
    except ImportError:
        venv = '/opt/agentos/office-venv/bin/python'
        if os.path.exists(venv) and os.environ.get('AGENTOS_OFFICE_REEXEC') != '1':
            os.environ['AGENTOS_OFFICE_REEXEC'] = '1'
            os.execv(venv, [venv] + sys.argv)
        die('Máy chưa có python-pptx nên chưa tạo được PowerPoint. Tạo Word hoặc PDF thay, hoặc cài: pip install python-pptx.')
    prs = Presentation()
    s0 = prs.slides.add_slide(prs.slide_layouts[0])
    s0.shapes.title.text = spec.get('title') or 'Bài trình bày'
    if len(s0.placeholders) > 1:
        s0.placeholders[1].text = ' · '.join([x for x in (spec.get('subtitle'), spec.get('author'), spec.get('date')) if x])
    for sl in spec.get('slides') or []:
        s = prs.slides.add_slide(prs.slide_layouts[1])
        s.shapes.title.text = sl.get('title') or ''
        body = s.placeholders[1].text_frame
        body.clear()
        for i, b in enumerate(sl.get('bullets') or []):
            para = body.paragraphs[0] if i == 0 else body.add_paragraph()
            para.text = b
        if sl.get('notes'):
            s.notes_slide.notes_text_frame.text = sl['notes']
    prs.save(out)


def create_any(kind, spec_path, out):
    import json
    with open(spec_path, encoding='utf-8') as f:
        spec = json.load(f)
    out = os.path.abspath(out)
    os.makedirs(os.path.dirname(out), exist_ok=True)
    if kind == 'docx':
        create_docx(spec, out)
    elif kind == 'xlsx':
        create_xlsx(spec, out)
    elif kind == 'pptx':
        create_pptx(spec, out)
    elif kind == 'pdf':
        tmpd = tempfile.mkdtemp(prefix='mk-pdf-')
        try:
            tmp = os.path.join(tmpd, 'tai-lieu.docx')
            create_docx(spec, tmp)
            made = soffice_convert(tmp, 'pdf', tmpd)
            shutil.move(made, out)
        finally:
            shutil.rmtree(tmpd, ignore_errors=True)
    else:
        die('Loại tạo mới: docx, xlsx, pptx, pdf (không phải %s).' % kind)
    print(out)


def main(argv):
    if len(argv) < 2 or argv[1] in ('-h', '--help', 'help'):
        sys.stdout.write(__doc__)
        return 0
    cmd = argv[1]
    args = argv[2:]
    opt = {}
    pos = []
    i = 0
    while i < len(args):
        if args[i] in ('--max', '--out', '--outdir') and i + 1 < len(args):
            opt[args[i]] = args[i + 1]
            i += 2
        else:
            pos.append(args[i])
            i += 1
    if cmd == 'create':
        if len(pos) < 2 or '--out' not in opt:
            die('Cách dùng: create <docx|xlsx|pptx|pdf> <mô-tả.json> --out <tệp ra>')
        create_any(pos[0], pos[1], opt['--out'])
        return 0
    if not pos:
        die('Thiếu đường dẫn tệp.')
    path = os.path.abspath(pos[0])
    if not os.path.isfile(path):
        die('Không thấy tệp: ' + path)
    if cmd == 'read':
        txt = read_any(path)
        mx = int(opt.get('--max', 6000))
        sys.stdout.write(txt if len(txt) <= mx else txt[:mx] + '\n… (cắt bớt, tổng %d ký tự; tăng --max để đọc thêm)' % len(txt))
        sys.stdout.write('\n')
    elif cmd == 'replace':
        if len(pos) < 3:
            die('Cách dùng: replace <tệp> <cũ> <mới> [--out <tệp>]')
        out, n = do_replace(path, pos[1], pos[2], opt.get('--out'))
        if n == 0:
            os.remove(out)
            die('Không thấy chữ "%s" trong tệp (thử cụm ngắn hơn).' % pos[1], 3)
        print('Đã thay %d chỗ. Tệp mới: %s' % (n, out))
    elif cmd == 'convert':
        if len(pos) < 2:
            die('Cách dùng: convert <tệp> <định dạng> [--outdir <thư mục>]')
        outdir = os.path.abspath(opt.get('--outdir') or os.path.dirname(path))
        os.makedirs(outdir, exist_ok=True)
        print(soffice_convert(path, pos[1], outdir))
    elif cmd == 'info':
        ext = os.path.splitext(path)[1].lower()
        extra = ''
        try:
            if ext == '.xlsx':
                import openpyxl
                wb = openpyxl.load_workbook(path, read_only=True)
                extra = ', %d trang tính: %s' % (len(wb.sheetnames), ', '.join(wb.sheetnames))
            elif ext == '.pptx':
                with zipfile.ZipFile(path) as z:
                    extra = ', %d slide' % len([n for n in z.namelist() if re.match(r'ppt/slides/slide\d+\.xml$', n)])
            elif ext == '.docx':
                extra = ', %d ký tự chữ' % len(read_docx(path))
        except Exception as e:  # noqa: BLE001
            extra = ' (không đọc được chi tiết: %s)' % e
        print('%s — %s, %d byte%s' % (os.path.basename(path), ext or 'không có đuôi', os.path.getsize(path), extra))
    else:
        die('Lệnh lạ: ' + cmd)
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv))
